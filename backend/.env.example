# 复制为 .env.local，并填写火山方舟密钥；不要提交 .env.local。
ARK_API_KEY=
# 模型在前端选择，后端只允许 Lite / Pro；未指定时默认 Lite。
PORT=8080
# 默认空值不信任代理；同机 Nginx 部署填写 127.0.0.1，不能填写所有来源。
# 多个受信 IP / CIDR 用逗号分隔；Nginx 必须覆写 X-Forwarded-For 为 $remote_addr。
TRUSTED_PROXIES=
# 音视频上传时读取真实媒体参数；留空使用 PATH 中的 ffprobe。
FFPROBE_PATH=

# PostgreSQL；登录和业务接口必需，缺失时返回 503，不允许匿名调用。
# 本地示例：postgres://frame_space:YOUR_PASSWORD@127.0.0.1:5432/frame_space?sslmode=disable
DATABASE_URL=

# 持久化队列：视频最多 3 个（个人账号）；图片额度独立，默认保守使用 1 个。
VIDEO_GENERATION_CONCURRENCY=3
IMAGE_GENERATION_CONCURRENCY=1
# 模型完成后释放生成名额，转存另行限流，避免占满带宽和临时磁盘。
ASSET_SAVE_CONCURRENCY=2

# 阿里云 OSS：填好后将 OSS_ENABLED 改为 true，再重启后端。
# 凭据仅在后端使用，与方舟的 ARK_API_KEY 无关。
OSS_ENABLED=false
OSS_REGION=
OSS_BUCKET=
# 可留空，由 Region 推导；例如 https://oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 只有使用 STS 临时凭据时填写
OSS_SESSION_TOKEN=
STORAGE_PREFIX=frame-space
STORAGE_ENV=dev

# 浏览器访问站点的准确来源（含协议与端口），不填写后端代理地址。
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 本机 HTTP 为 false；正式 HTTPS 必须为 true（使用 __Host- Cookie）。
AUTH_COOKIE_SECURE=false
